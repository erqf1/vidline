; Vidline installer (Inno Setup 6). Build: iscc /DMyAppVersion=1.10.2 packaging\windows\vidline.iss
; Expects the portable build in dist\Vidline (see build.bat / release workflow).
#ifndef MyAppVersion
  #define MyAppVersion "1.0.0"
#endif

[Setup]
AppId={{B7D0C3E2-5A41-4C7E-9B61-3F2A8E6D1C90}
AppName=Vidline
AppVersion={#MyAppVersion}
AppPublisher=Vidline
AppVerName=Vidline {#MyAppVersion}
DefaultDirName={autopf}\Vidline
DefaultGroupName=Vidline
UninstallDisplayIcon={app}\Vidline.exe
SetupIconFile=..\..\assets\icon.ico
OutputDir=..\..\dist
OutputBaseFilename=Vidline-windows-x64-setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ChangesAssociations=yes
DisableProgramGroupPage=yes
DisableDirPage=no
UsePreviousAppDir=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "openwith"; Description: "Show Vidline in the ""Open with"" menu of video files (recommended)"; GroupDescription: "Video player:"
Name: "desktopicon"; Description: "Create a &desktop shortcut"; GroupDescription: "Shortcuts:"; Flags: unchecked

[Files]
Source: "..\..\dist\Vidline\*"; DestDir: "{app}"; Excludes: "Cutline.exe"; Flags: recursesubdirs ignoreversion
; Nur bei Installationen von vor der Umbenennung (hieß Cutline): der alte Name startet Vidline
Source: "..\..\dist\Vidline\Cutline.exe"; DestDir: "{app}"; Flags: ignoreversion; Check: WasCutline

[InstallDelete]
Type: files; Name: "{autoprograms}\Cutline.lnk"
Type: files; Name: "{autodesktop}\Cutline.lnk"

[Icons]
Name: "{autoprograms}\Vidline"; Filename: "{app}\Vidline.exe"; AppUserModelID: "WSoftware.Cutline"
Name: "{autodesktop}\Vidline"; Filename: "{app}\Vidline.exe"; AppUserModelID: "WSoftware.Cutline"; Tasks: desktopicon

[Run]
Filename: "{app}\Vidline.exe"; Description: "Start Vidline"; Flags: nowait postinstall skipifsilent

[Registry]
; Program identity (shows up in "Open with" and in Default apps)
Root: HKA; Subkey: "Software\Classes\Applications\Vidline.exe"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "Vidline"; Flags: uninsdeletekey; Tasks: openwith
Root: HKA; Subkey: "Software\Classes\Applications\Vidline.exe\DefaultIcon"; ValueType: string; ValueData: "{app}\Vidline.exe,0"; Tasks: openwith
Root: HKA; Subkey: "Software\Classes\Applications\Vidline.exe\shell\open\command"; ValueType: string; ValueData: """{app}\Vidline.exe"" ""%1"""; Tasks: openwith
Root: HKA; Subkey: "Software\Vidline\Capabilities"; ValueType: string; ValueName: "ApplicationName"; ValueData: "Vidline"; Flags: uninsdeletekey; Tasks: openwith
Root: HKA; Subkey: "Software\Vidline\Capabilities"; ValueType: string; ValueName: "ApplicationDescription"; ValueData: "Simple, fast video editor and player"; Tasks: openwith
Root: HKA; Subkey: "Software\RegisteredApplications"; ValueType: string; ValueName: "Vidline"; ValueData: "Software\Vidline\Capabilities"; Flags: uninsdeletevalue; Tasks: openwith
; Aufräumen nach der Umbenennung von Cutline; die ProgIDs Cutline.<endung> bleiben, sonst gingen gewählte Standard-Apps verloren
Root: HKA; Subkey: "Software\RegisteredApplications"; ValueType: none; ValueName: "Cutline"; Flags: deletevalue
Root: HKA; Subkey: "Software\Cutline"; ValueType: none; Flags: deletekey
Root: HKA; Subkey: "Software\Classes\Applications\Cutline.exe"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "Vidline"; Flags: dontcreatekey uninsdeletekey
; One ProgID per file type with its own file icon (light/dark switchable in Vidline) - generated by tools_make_filetype_icons.py
#include "filetypes.iss"

[Code]
function WasCutline: Boolean;
begin
  Result := FileExists(ExpandConstant('{app}\Cutline.exe'));
end;
